# URL pública del sitio (para metadataBase, sitemap, OG). En Vercel: https://<proyecto>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de contacto (Resend, plan gratis: https://resend.com). Sin clave, en local el
# mensaje solo se imprime en la terminal del servidor.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=tu-correo@ejemplo.com
# CONTACT_FROM_EMAIL=Portafolio <onboarding@resend.dev>

# Fase 2 — chat "Pregúntale a mi portafolio". Sin clave, el chat responde en modo simulado.
# ANTHROPIC_API_KEY=

# Fase 2 — widget de GitHub (opcional, sube el límite de la API pública).
# GITHUB_TOKEN=

# Fase 3 — Neon + Prisma + NextAuth
# DATABASE_URL=
# AUTH_SECRET=
